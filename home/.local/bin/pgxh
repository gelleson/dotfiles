#!/usr/bin/env python3
import argparse
import os
import subprocess
import sys
from urllib.parse import unquote, urlsplit

client = "hsql" if os.path.basename(sys.argv[0]) == "pgxhs" else "harlequin"
parser = argparse.ArgumentParser(description=f"Open {client} on a PGX database.")
parser.add_argument("database")
parser.add_argument("options", nargs=argparse.REMAINDER, help="Options for the client")
args = parser.parse_args()

result = subprocess.run(
    ["pgx", "url", args.database], stdout=subprocess.PIPE, text=True
)
if result.returncode:
    raise SystemExit(result.returncode)

url = urlsplit(result.stdout.strip())
env = os.environ.copy()
# Connect to this database instead of an inherited hsql session.
env.pop("HSQL_SESSION", None)
# Keep the password out of the client's process arguments.
env["PGPASSWORD"] = unquote(url.password or "")
address = url.netloc.rsplit("@", 1)[-1]
connection = url._replace(netloc=f"{url.username}@{address}").geturl()
os.execvpe(
    client, [client, "--profile", "None", "-a", "postgres", connection, *args.options], env
)
