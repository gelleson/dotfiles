#!/usr/bin/env zsh
# Lay out the standard four tabs in the current Herdr space: the tab you run it
# from becomes `ai`, then editor (nvim .), git (lazygit), and a plain shell.
# Aliased to `hp`. Everything opens in the current directory.

# Scripts get /etc/zshenv's PATH, not .zprofile's, so the shims go on by hand.
path=($HOME/.local/share/mise/shims $path)

[[ -n $HC_TERMINAL_ID ]] || { print -u2 "hp: not inside a Herdr terminal"; exit 1 }

# Herdr labels every terminal it starts with its space and tab.
hc get $HC_TERMINAL_ID --json | python3 -c '
import json, sys
labels = json.load(sys.stdin)["labels"]
print(labels["herdr.space"], labels["herdr.tab"])' | read space tab

herdr-app do tab.rename --id $tab --name ai >/dev/null
herdr-app do tab.new --space $space --folder $PWD --name editor --argv '["nvim","."]' >/dev/null
herdr-app do tab.new --space $space --folder $PWD --name git --argv '["lazygit"]' >/dev/null
herdr-app do tab.new --space $space --folder $PWD --name terminal >/dev/null
herdr-app do tab.select --id $tab >/dev/null
