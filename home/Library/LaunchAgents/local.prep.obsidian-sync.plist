<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Two-way sync of the interview prep repo (learn/, cycles/) with the Obsidian
  vault "prep" in iCloud. Script and tests live in the prep repo: bin/obsidian-sync.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.prep.obsidian-sync</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/gelleson/codes/namespaces/interview/prep/bin/obsidian-sync</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/opt/homebrew/bin:/usr/bin:/bin</string>
	</dict>
	<!-- ponytail: 30 s poll; unison -repeat watch + fsmonitor if latency matters -->
	<key>StartInterval</key>
	<integer>30</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/gelleson/Library/Logs/prep-obsidian-sync.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/gelleson/Library/Logs/prep-obsidian-sync.log</string>
</dict>
</plist>
