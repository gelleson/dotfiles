<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Lets the Omnigent server accept browsers on the tailnet URL that
  `tailscale serve` fronts. The desktop app spawns the server and copies only
  PATH from the login shell, so the allowlist has to live in launchd's env.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.omnigent.env</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/launchctl</string>
		<string>setenv</string>
		<string>OMNIGENT_WS_ALLOWED_ORIGINS</string>
		<string>https://aks-macbook-pro.betta-iwato.ts.net</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
