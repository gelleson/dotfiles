{
  "version": 2,
  "enabled": true,
  "hyprKey": "capsLock",
  "focusFollowsMouse": false,
  "gapSize": 8,
  "outerPadding": 8,
  "keybinds": [
    {
      "keyCode": 36,
      "modifiers": 1,
      "action": {
        "runCommand": {
          "label": "New Ghostty window",
          "command": "/usr/bin/open -na Ghostty"
        }
      }
    },
    {
      "keyCode": 44,
      "modifiers": 1,
      "action": {
        "toggleSplit": {}
      }
    },
    {
      "keyCode": 3,
      "modifiers": 3,
      "action": {
        "toggleFloating": {}
      }
    },
    {
      "keyCode": 11,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "company.thebrowser.Browser"
        }
      }
    },
    {
      "keyCode": 5,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "com.mitchellh.ghostty"
        }
      }
    },
    {
      "keyCode": 4,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "dev.herdr.app"
        }
      }
    },
    {
      "keyCode": 15,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "com.superlogical.rex"
        }
      }
    },
    {
      "keyCode": 17,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "com.t3tools.t3code"
        }
      }
    },
    {
      "keyCode": 13,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "dev.warp.Warp-Stable"
        }
      }
    },
    {
      "keyCode": 1,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "com.sunsama.native-app"
        }
      }
    },
    {
      "keyCode": 14,
      "modifiers": 1,
      "action": {
        "launchApp": {
          "bundleID": "dev.zed.Zed"
        }
      }
    },
    {
      "keyCode": 31,
      "modifiers": 1,
