# Git identity. Without it git invents one from the hostname
# (user@Machine.local), which GitHub cannot link to the account.
[user]
	name = gelleson
	email = altynbek@higgsfield.ai

# delta (from mise) renders diffs, log -p, show and blame; n/N jump between files.
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true

# GitHub auth through gh (from mise). Plain `gh`, not an absolute path: the
# path `gh auth setup-git` writes names the gh version and breaks on upgrade.
[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !gh auth git-credential
